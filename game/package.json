{
  "name": "uaidzin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bot": "node scripts/bot-play.mjs",
    "test:save": "node scripts/save-harness.mjs",
    "smoke": "node scripts/smoke.mjs",
    "cycle-balance": "node scripts/cycle-balance.mjs",
    "cycle-demo": "node scripts/cycle-demo.mjs",
    "devtools:mcp": "DEV_PORT=5173 BROWSER=none npx -y threejs-devtools-mcp@0.4.1",
    "devtools:verify": "node scripts/threejs-devtools-verify.mjs",
    "vfx:catalog": "node scripts/generate-vfx-catalog.mjs",
    "vfx:build": "node scripts/build-vfx-dist.mjs",
    "vfx:build:local-pack": "node scripts/build-vfx-dist.mjs --local-pack",
    "vfx:manifest": "node scripts/vfx/extract-skills-manifest.mjs",
    "vfx:manifest:validate": "node scripts/vfx/validate-skills-manifest.mjs",
    "vfx:qa": "node scripts/check-vfx-master.mjs",
    "vfx:runtime:qa": "node scripts/check-skill-vfx.mjs",
    "vfx:atelier:validate": "node scripts/vfx/extract-skills-manifest.mjs --check && node scripts/vfx/validate-skills-manifest.mjs && node scripts/vfx/validate-atelier.mjs --complete && node scripts/vfx/write-atelier-brief.mjs --check",
    "vfx:atelier:brief": "node scripts/vfx/write-atelier-brief.mjs",
    "vfx:atelier:qa": "node scripts/vfx/check-atelier.mjs && node scripts/vfx/check-atelier-ui.mjs",
    "vfx:check": "node scripts/check-vfx-master.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "three.quarks": "^0.16.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/three": "^0.170.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
